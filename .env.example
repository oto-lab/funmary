# Funmary の環境変数の例
#
# 手元の開発とテストでは、このファイルを .env に写して値を書きます (pnpm funmary init でも作れます)。.env は Git の管理対象外です。.env.local などは使いません。
# 本番の値は手元に置かず、VPS の /etc/funmary/funmary.env に同じ形で書きます。
# 空の値は "設定しない" を意味し、既定値が使われます。起動時に値を検証し、足りない値や形式の誤りがあれば、どの変数をどう直すかを表示して止まります。
# 年度や学期に関わる値は、ここには置きません。

# ---- サーバー ----

# 公開 URL。本番では必須
ORIGIN=
# 待ち受けるアドレスとポート。既定は 127.0.0.1 と 28461 (ほかのソフトと被りにくい、IANA で未割り当ての番号)
HOST=
PORT=
# DB とバックアップの置き場所。既定は ./data
DATA_DIR=

# ---- 鍵 (必須。pnpm funmary init が生成する) ----

SESSION_SECRET=
ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 連絡先を mailto: で書く。例: mailto:admin@funmary.example.com
VAPID_SUBJECT=

# ---- Google のログイン (必須) ----

# Google Cloud Console で作った OAuth クライアント (種類は "ウェブ アプリケーション")
# 承認済みのリダイレクト URI は <公開 URL>/auth/google/callback。手元では http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 登録と管理者 ----

# ログインを許すメールアドレスのドメイン (カンマ区切り)。既定は fun.ac.jp
ALLOWED_EMAIL_DOMAINS=
# 新規登録の方式。invite (既定、招待コードを持つ人だけ)、open、closed のどれか
REGISTRATION=
# 一般ユーザーが毎月発行できる招待コードの数。既定は 0 (管理者だけが発行する)
INVITES_PER_USER=
# 管理者のメールアドレス (カンマ区切り)
ADMIN_EMAILS=

# ---- 取得元 ----

# 学生ポータルのアカウント。本番では必須。開発中は空でよい
PORTAL_USER_ID=
PORTAL_PASSWORD=
# 取得を止める取得元 (カンマ区切り)。緊急用
SOURCES_DISABLED=
# 開発用。指定すると、取得元に接続せず、このディレクトリの保存済みの HTML から読み込む
SOURCES_FIXTURE_DIR=

# ---- 通知 ----

# メールの送信に使う SMTP サーバー。空ならメールの機能は無効
SMTP_URL=
MAIL_FROM=
# 管理用の Discord の Webhook の URL。取得元の不調、エラー、VPS への反映の結果など、Funmary 自体の状態が届く
# 利用者が授業の通知を受け取るための Webhook とは別のもので、利用者の Webhook は各自が設定画面で登録する。空ならログにだけ残す
ADMIN_DISCORD_WEBHOOK_URL=
# 開発中は既定で送信せず、内容をコンソールに出す。false にすると実際に送る
NOTIFY_DRY_RUN=

# ---- 監視とログ ----

# 定期処理の完了を知らせる監視サービス (healthchecks.io など) の URL
HEARTBEAT_URL=
# debug、info、warn、error のどれか。既定は本番で info、開発で debug
LOG_LEVEL=
# text (既定) か json
LOG_FORMAT=

# ---- リバースプロキシ (本番のみ) ----

# 利用者の IP アドレスを得るための設定。nginx なら X-Forwarded-For と 1
ADDRESS_HEADER=
XFF_DEPTH=
